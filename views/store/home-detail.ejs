<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-slate-50 text-gray-800">
    <header>
        <%- include('../partials/nav') %>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Home Image -->
        <div class="relative overflow-hidden rounded-3xl bg-gray-200 shadow-lg">
            <img
                src="<%= home.photoUrl %>"
                alt="<%= home.houseName %>"
                class="h-72 w-full object-cover sm:h-96 lg:h-[480px]"
            >

            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

            <div class="absolute bottom-5 left-5 right-5 sm:bottom-8 sm:left-8">
                <span class="inline-block rounded-full bg-white/95 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-blue-700 shadow-sm">
                    Discover your next stay
                </span>
            </div>
        </div>

        <!-- Home Details -->
        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">

            <!-- Main Information -->
            <div class="space-y-8 lg:col-span-2">

                <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8">

                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                        <div class="min-w-0">
                            <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-blue-600">
                                Property details
                            </p>

                            <h1 class="break-words text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                                <%= home.houseName %>
                            </h1>

                            <p class="mt-4 flex items-center gap-2 text-base text-gray-500">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    class="h-5 w-5 shrink-0 text-blue-600"
                                >
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M12 21s7-5.5 7-12a7 7 0 1 0-14 0c0 6.5 7 12 7 12Z"/>
                                    <circle cx="12" cy="9" r="2.2"/>
                                </svg>

                                <span><%= home.location %></span>
                            </p>
                        </div>

                        <!-- Rating -->
                        <div class="flex w-fit shrink-0 items-center gap-2 rounded-xl bg-amber-50 px-4 py-3">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                class="h-6 w-6 text-amber-400"
                            >
                                <path fill-rule="evenodd"
                                    d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
                                    clip-rule="evenodd"
                                />
                            </svg>

                            <div>
                                <p class="text-lg font-bold text-slate-900">
                                    <%= home.rating %>
                                </p>
                                <p class="text-xs text-gray-500">Rating</p>
                            </div>
                        </div>
                    </div>

                    <div class="my-7 border-t border-gray-100"></div>

                    <!-- Description -->
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">
                            About this home
                        </h2>

                        <p class="mt-3 text-base leading-7 text-gray-600">
                            Beautiful home with modern interiors, spacious
                            rooms and peaceful surroundings.
                        </p>
                    </div>
                </section>

                <!-- Amenities -->
                <section class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8">
                    <h2 class="text-xl font-bold text-slate-900">
                        Amenities
                    </h2>

                    <p class="mt-2 text-sm text-gray-500">
                        Comfort and convenience for your stay.
                    </p>

                    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">

                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-4">
                            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8"
                                    class="h-5 w-5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M5 9a10 10 0 0 1 14 0M8 12a6 6 0 0 1 8 0m-5 3a2 2 0 0 1 2 0m-1 4h.01"/>
                                </svg>
                            </span>
                            <span class="font-medium text-gray-700">Free WiFi</span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-4">
                            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8"
                                    class="h-5 w-5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M3 13h18M5 13V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v5M5 13v5m14-5v5M3 18h18"/>
                                </svg>
                            </span>
                            <span class="font-medium text-gray-700">Parking</span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-4">
                            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8"
                                    class="h-5 w-5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M3 12h18M5 12a7 7 0 0 1 14 0m-14 0v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/>
                                </svg>
                            </span>
                            <span class="font-medium text-gray-700">Swimming Pool</span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-4">
                            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8"
                                    class="h-5 w-5">
                                    <rect x="4" y="4" width="16" height="16" rx="3"/>
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M9 9h6v6H9zM12 2v2m0 16v2M2 12h2m16 0h2"/>
                                </svg>
                            </span>
                            <span class="font-medium text-gray-700">Air Conditioner</span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-4">
                            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8"
                                    class="h-5 w-5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M4 11h16v9H4zM3 11l2-7h14l2 7M8 15h.01M12 15h.01M16 15h.01"/>
                                </svg>
                            </span>
                            <span class="font-medium text-gray-700">Kitchen</span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-4">
                            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8"
                                    class="h-5 w-5">
                                    <rect x="3" y="5" width="18" height="13" rx="2"/>
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M8 21h8m-4-3v3"/>
                                </svg>
                            </span>
                            <span class="font-medium text-gray-700">TV</span>
                        </div>

                    </div>
                </section>
            </div>

            <!-- Price and Favourite -->
            <aside class="lg:col-span-1">
                <div class="sticky top-6 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8">

                    <p class="text-sm font-medium text-gray-500">
                        Price per night
                    </p>

                    <div class="mt-2 flex items-baseline gap-2">
                        <span class="text-3xl font-extrabold text-blue-700">
                            ₹<%= home.price %>
                        </span>
                        <span class="text-sm text-gray-500">/ night</span>
                    </div>

                    <div class="my-6 border-t border-gray-100"></div>

                    <h2 class="mb-2 text-lg font-bold text-slate-900">
                        Interested in this home?
                    </h2>

                    <p class="mb-5 text-sm leading-6 text-gray-500">
                        Save this property to your favourites so you can find it easily later.
                    </p>

                    <div class="rounded-xl bg-blue-50 p-4">
                        <%- include('../partials/favourite') %>
                    </div>

                </div>
            </aside>

        </div>
    </main>
</body>
</html>