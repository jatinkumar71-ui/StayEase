<%- include('../partials/head') %>
    </head>
    <body class="bg-gray-100">
        <header>
            <!-- Navbar -->
            <%- include('../partials/nav') %>
        </header>
        <main class="max-w-5xl mx-auto px-6 py-10">
            <!-- Image -->
            <img
                src="<%= home.photoUrl %>"
                class="w-full h-[450px] object-cover rounded-xl shadow-lg"
            >

            <!-- Details -->
            <div class="mt-8">

                <div class="flex justify-between items-center">
                    <h1 class="text-4xl font-bold">
                        <%= home.houseName %>
                    </h1>

                    <span class="text-yellow-500 text-xl">
                        ⭐ <%= home.rating %>
                    </span>
                </div>

                <p class="text-gray-600 mt-3 text-lg">
                    📍 <%= home.location %>
                </p>

                <p class="text-3xl font-bold text-blue-600 mt-4">
                    ₹<%= home.price %> / Night
                </p>

            </div>

            <!-- Description -->

            <div class="mt-10">
                <h2 class="text-2xl font-semibold mb-3">
                    About this Home
                </h2>

                <p class="text-gray-700 leading-8">
                    Beautiful home with modern interiors, spacious
                    rooms and peaceful surroundings.
                </p>
            </div>

            <!-- Amenities -->

            <div class="mt-10">

                <h2 class="text-2xl font-semibold mb-4">
                    Amenities
                </h2>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">

                    <div>✔ Free WiFi</div>
                    <div>✔ Parking</div>
                    <div>✔ Swimming Pool</div>
                    <div>✔ Air Conditioner</div>
                    <div>✔ Kitchen</div>
                    <div>✔ TV</div>

                </div>

            </div>

            <!-- Button -->
            <div class="mt-12">
                <%- include('../partials/favourite') %>
            </div>

        </main>
    </body>
</html>