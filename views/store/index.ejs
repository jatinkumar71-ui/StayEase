<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-slate-50 text-gray-800">
    <header>
        <%- include('../partials/nav') %>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

        <!-- Page Heading -->
        <div class="mb-10 text-center">
            <span class="mb-3 inline-block rounded-full bg-blue-100 px-4 py-1.5 text-sm font-semibold text-blue-700">
                Find your next stay
            </span>

            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                Welcome to <span class="text-blue-600">StayEase</span>
            </h1>

            <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-gray-500 sm:text-base">
                Discover comfortable homes and make every stay feel special.
            </p>

            <div class="mx-auto mt-5 h-1 w-16 rounded-full bg-blue-600"></div>
        </div>

        <!-- Homes Grid -->
        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

            <% registeredHomes.forEach(home => { %>

                <div class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                    <!-- Home Image -->
                    <div class="relative overflow-hidden bg-gray-100">
                        <img
                            src="<%= home.photoUrl %>"
                            alt="<%= home.houseName %>"
                            class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
                        >

                        <div class="absolute right-3 top-3 flex items-center gap-1 rounded-full bg-white/95 px-3 py-1.5 text-sm font-semibold text-gray-800 shadow-sm">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                class="h-4 w-4 text-amber-400"
                            >
                                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"/>
                            </svg>
                            <%= home.rating %>
                        </div>
                    </div>

                    <!-- Home Details -->
                    <div class="p-5">
                        <h2 class="mb-2 truncate text-lg font-bold text-slate-900 transition group-hover:text-blue-700">
                            <%= home.houseName %>
                        </h2>

                        <p class="mb-5 flex items-center gap-2 text-sm text-gray-500">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                class="h-4 w-4 shrink-0 text-blue-600"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.5 7-12a7 7 0 1 0-14 0c0 6.5 7 12 7 12Z"/>
                                <circle cx="12" cy="9" r="2.2"/>
                            </svg>
                            <span class="truncate"><%= home.location %></span>
                        </p>

                        <div class="flex items-end justify-between gap-3 border-t border-gray-100 pt-4">
                            <div>
                                <p class="text-xs font-medium uppercase tracking-wide text-gray-400">
                                    Price per night
                                </p>
                                <p class="mt-1 text-xl font-extrabold text-blue-700">
                                    ₹<%= home.price %>
                                </p>
                            </div>

                            <button
                                type="button"
                                class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                            >
                                Book
                            </button>
                        </div>
                    </div>

                </div>

            <% }) %>

        </div>
    </main>
</body>
</html>