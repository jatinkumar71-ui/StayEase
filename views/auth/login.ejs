<%- include('../partials/head') %>
</head>
    <body>
        <header>
            <!-- Navbar -->
            <%- include('../partials/nav') %>
        </header>
        <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
            <h1 class="text-3xl font-bold mb-6 text-center text-blue-600">
                Please enter your email and password to log in.
            </h1>

            <form action="/login" method="POST" class="max-w-md mx-auto">

                <input
                    type="text"
                    name="username"
                    placeholder="Enter your email/username"
                    class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    required
                >

                <input
                    type="password"
                    name="passward"
                    placeholder="Enter your passward"
                    class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    required
                >

                <input
                    type="submit"
                    value="Sign In"
                    class="w-full bg-blue-600 text-white py-2 rounded-md hover:bg-red-500 transition duration-300"
                >
            </form>
        </main>
    </body>
</html>