<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800">

    <header>
        <!-- Navbar -->
        <%- include('../partials/nav') %>
    </header>

    <main class="flex min-h-[85vh] items-center justify-center px-4 py-10 sm:px-6">

        <div class="w-full max-w-xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-blue-100/50">

            <!-- Blue Accent -->
            <div class="h-2 bg-gradient-to-r from-blue-500 via-blue-600 to-sky-400"></div>

            <div class="p-6 sm:p-9">

                <!-- Heading -->
                <div class="mb-8 text-center">

                    <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 ring-1 ring-blue-100">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.8"
                            stroke="currentColor"
                            class="h-8 w-8 text-blue-600"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3.75 20.1a7.5 7.5 0 0 1 12.5-5.625"
                            />
                        </svg>
                    </div>

                    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                        Create Your <span class="text-blue-600">Account</span>
                    </h1>

                    <p class="mt-3 text-sm leading-6 text-slate-500">
                        Join StayEase and get started today.
                    </p>

                </div>

                <!-- Signup Form -->
                <form action="/signup" method="POST" class="space-y-5">

                    <%- include('../partials/errors') %>

                    <!-- First and Last Name -->
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                        <div>
                            <label for="firstName" class="mb-2 block text-sm font-semibold text-slate-700">
                                First Name
                            </label>

                            <input
                                id="firstName"
                                type="text"
                                name="firstName"
                                placeholder="First name"
                                value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                                autocomplete="given-name"
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                                required
                            >
                        </div>

                        <div>
                            <label for="lastName" class="mb-2 block text-sm font-semibold text-slate-700">
                                Last Name
                            </label>

                            <input
                                id="lastName"
                                type="text"
                                name="lastName"
                                placeholder="Last name"
                                value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
                                autocomplete="family-name"
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                                required
                            >
                        </div>

                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">
                            Email Address
                        </label>

                        <input
                            id="email"
                            type="email"
                            name="email"
                            placeholder="Enter your email"
                            value="<%= oldInput.email ? oldInput.email : '' %>"
                            autocomplete="email"
                            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                            required
                        >
                    </div>

                    <!-- Passwords -->
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                        <div>
                            <label for="password" class="mb-2 block text-sm font-semibold text-slate-700">
                                Password
                            </label>

                            <input
                                id="password"
                                type="password"
                                name="password"
                                placeholder="Create password"
                                autocomplete="new-password"
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                                required
                            >
                        </div>

                        <div>
                            <label for="confirmPassword" class="mb-2 block text-sm font-semibold text-slate-700">
                                Confirm Password
                            </label>

                            <input
                                id="confirmPassword"
                                type="password"
                                name="confirmPassword"
                                placeholder="Confirm password"
                                autocomplete="new-password"
                                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                                required
                            >
                        </div>

                    </div>

                    <!-- User Type -->
                    <fieldset class="rounded-2xl border border-slate-200 bg-slate-50/80 p-4">

                        <legend class="px-1 text-sm font-semibold text-slate-700">
                            I want to join as
                        </legend>

                        <div class="mt-2 grid grid-cols-2 gap-3">

                            <label for="guest" class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50/50">
                                <input
                                    type="radio"
                                    name="userType"
                                    value="guest"
                                    id="guest"
                                    class="h-4 w-4 accent-blue-600 focus:ring-blue-500"
                                    <% if(oldInput.userType === 'guest'){ %>checked<% } %>
                                >

                                <span class="text-sm font-semibold text-slate-700">
                                    Guest
                                </span>
                            </label>

                            <label for="host" class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50/50">
                                <input
                                    type="radio"
                                    name="userType"
                                    value="host"
                                    id="host"
                                    class="h-4 w-4 accent-blue-600 focus:ring-blue-500"
                                    <% if(oldInput.userType === 'host'){ %>checked<% } %>
                                >

                                <span class="text-sm font-semibold text-slate-700">
                                    Host
                                </span>
                            </label>

                        </div>
                    </fieldset>

                    <!-- Terms -->
                    <div class="flex items-start gap-3 rounded-xl bg-blue-50/60 p-4">
                        <input
                            id="terms"
                            type="checkbox"
                            name="terms"
                            required
                            class="mt-0.5 h-4 w-4 shrink-0 rounded accent-blue-600 focus:ring-blue-500"
                        >

                        <label for="terms" class="cursor-pointer text-sm leading-5 text-slate-600">
                            I agree to the terms and conditions.
                        </label>
                    </div>

                    <!-- Submit -->
                    <div class="pt-1">
                        <input
                            type="submit"
                            value="Create Account"
                            class="w-full cursor-pointer rounded-xl bg-blue-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-200 transition-all duration-200 hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-blue-200"
                        >
                    </div>

                </form>

            </div>
        </div>

    </main>

</body>
</html>
