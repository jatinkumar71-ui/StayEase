```ejs
<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800">

    <header>
        <!-- Navbar -->
        <%- include('../partials/nav') %>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 sm:py-14">

        <!-- Page Heading -->
        <div class="mb-8 text-center">
            <span class="mb-4 inline-flex rounded-full border border-blue-100 bg-blue-50 px-4 py-1.5 text-sm font-semibold text-blue-700">
                Host Dashboard
            </span>

            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                <%= editing ? "Edit" : "Register" %>
                <span class="text-blue-600">Your Home</span>
            </h1>

            <p class="mt-3 text-sm text-slate-500 sm:text-base">
                <%= editing ? "Update your property details below." : "Enter your property details to list your home on StayEase." %>
            </p>
        </div>

        <!-- Form Card -->
        <div class="mx-auto max-w-2xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-blue-100/40">

            <div class="h-1.5 bg-gradient-to-r from-blue-500 via-blue-600 to-sky-400"></div>

            <form
                action="/host/<%= editing ? 'edit-home' : 'add-home' %>"
                method="POST"
                enctype="multipart/form-data"
                class="space-y-6 p-6 sm:p-9"
            >

                <input type="hidden" name="id" value="<%= editing ? home._id : '' %>">

                <!-- House Name -->
                <div>
                    <label for="houseName" class="mb-2 block text-sm font-semibold text-slate-700">
                        House Name
                    </label>

                    <input
                        id="houseName"
                        type="text"
                        name="houseName"
                        value="<%= editing ? home.houseName : '' %>"
                        placeholder="Enter your house name"
                        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                    >
                </div>

                <!-- Price and Rating -->
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                    <div>
                        <label for="price" class="mb-2 block text-sm font-semibold text-slate-700">
                            Price Per Night (₹)
                        </label>

                        <input
                            id="price"
                            type="text"
                            name="price"
                            value="<%= editing ? home.price : '' %>"
                            placeholder="e.g. 1999"
                            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                        >
                    </div>

                    <div>
                        <label for="rating" class="mb-2 block text-sm font-semibold text-slate-700">
                            Rating
                        </label>

                        <input
                            id="rating"
                            type="text"
                            name="rating"
                            value="<%= editing ? home.rating : '' %>"
                            placeholder="e.g. 4.8"
                            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                        >
                    </div>

                </div>

                <!-- Location -->
                <div>
                    <label for="location" class="mb-2 block text-sm font-semibold text-slate-700">
                        Location
                    </label>

                    <input
                        id="location"
                        type="text"
                        name="location"
                        value="<%= editing ? home.location : '' %>"
                        placeholder="Enter property location"
                        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                    >
                </div>

                <!-- Property Image -->
                <div>
                    <label for="photoUrl" class="mb-2 block text-sm font-semibold text-slate-700">
                        Property Image
                    </label>

                    <div class="rounded-xl border border-dashed border-blue-200 bg-blue-50/50 p-4 transition duration-200 hover:border-blue-400">
                        <input
                            id="photoUrl"
                            type="file"
                            name="photoUrl"
                            accept="image/jpg, image/jpeg, image/png"
                            class="block w-full cursor-pointer text-sm text-slate-600 file:mr-4 file:cursor-pointer file:rounded-lg file:border-0 file:bg-blue-600 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-white hover:file:bg-blue-700"
                        >

                        <p class="mt-2 text-xs text-slate-500">
                            Accepted formats: JPG, JPEG and PNG.
                        </p>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label for="description" class="mb-2 block text-sm font-semibold text-slate-700">
                        Property Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        placeholder="Describe your home..."
                        class="w-full resize-y rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-800 placeholder:text-slate-400 transition duration-200 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
                    ><%= editing ? home.description : '' %></textarea>
                </div>

                <!-- Submit Button -->
                <div class="border-t border-slate-100 pt-5">
                    <input
                        type="submit"
                        value="<%= editing ? 'Update Home' : 'Submit Home' %>"
                        class="w-full cursor-pointer rounded-xl bg-blue-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-200 transition-all duration-200 hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-blue-200"
                    >
                </div>

            </form>
        </div>

    </main>

</body>
</html>
```